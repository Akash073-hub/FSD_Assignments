<%- include("partials/header", { title }) %>
<section class="page-heading narrow"><div><p class="eyebrow">FindHub / Contribution desk</p><h1>Report an item</h1><p>Give us enough detail to make a useful match without exposing anything only the owner should know.</p></div></section>
<% if (submitted) { %><div class="success-banner"><strong>Report received.</strong> “<%= itemTitle %>” is now in the campus review queue. <a href="/search">Browse matching records →</a></div><% } %>
<div class="form-layout"><form class="report-form" action="/report" method="post"><label>Item name<input name="title" required placeholder="e.g. Blue Hydro Flask 32oz"></label><label>Where did you find it?<input name="location" required placeholder="e.g. North Campus Gate 2"></label><div class="form-row"><label>Category<select name="category"><option>Electronics</option><option>IDs &amp; Wallets</option><option>Bags &amp; Apparel</option><option>Keys &amp; Wallets</option><option>Books &amp; Stationery</option></select></label><label>When?<input name="date" type="date" required></label></div><label>Useful identifying details<textarea name="description" rows="5" required placeholder="Colour, markings, initials, condition..."></textarea></label><button class="button button-dark" type="submit">Submit report <span>→</span></button></form><aside class="side-note"><span class="note-mark">!</span><h2>Good to know</h2><p>Keep unique identifying details private. Our desk uses them to verify the rightful owner before release.</p><hr><p class="mono">REVIEW WINDOW<br><strong>Usually under 18 hours</strong></p></aside></div>
<%- include("partials/footer") %>

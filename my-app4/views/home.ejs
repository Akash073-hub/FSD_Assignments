<%- include("partials/header", { title }) %>
<section class="library-hero"><div class="hero-copy"><p class="eyebrow">WELCOME BACK, AKASH <span class="live-dot"></span></p><h1>Level up your<br><em>next adventure.</em></h1><p class="intro-copy">Discover your next obsession from a library curated for players who like to wander off the map.</p><div class="hero-actions"><a class="button button-primary" href="#featured">Explore featured <span>→</span></a><a class="text-link" href="/profile">View your profile <span>↗</span></a></div></div><div class="hero-console" aria-label="Game controller illustration"><span class="controller-dpad">✦</span><span class="controller-buttons">● ●</span><span class="controller-line"></span><small>READY PLAYER ONE</small></div></section>
<section class="stat-strip" aria-label="Your library stats"><div><span>LIBRARY SIZE</span><strong>48 <small>games</small></strong></div><div><span>PLAY TIME</span><strong>186 <small>hours</small></strong></div><div><span>COMPLETED</span><strong>24 <small>games</small></strong></div><div><span>YOUR LEVEL</span><strong>27 <small>player</small></strong></div></section>
<section class="featured-section" id="featured"><div class="section-heading"><div><p class="eyebrow">HANDPICKED FOR YOU</p><h2>Featured games</h2></div><a class="text-link" href="/search">View all games <span>→</span></a></div><div class="game-grid"><% featuredGames.forEach((game, index) => { %><article class="game-card game-<%= game.art %> <%= index === 0 ? 'featured-card' : '' %>"><div class="game-art"><span class="game-badge"><%= index === 0 ? "EDITOR'S PICK" : "TOP RATED" %></span><span class="art-mark"><%= index === 0 ? '✦' : index === 1 ? '◈' : '◉' %></span><span class="art-title"><%= game.title %></span></div><div class="game-info"><div><h3><%= game.title %></h3><p><%= game.genre %> <span>•</span> <%= game.platform %></p></div><strong>★ <%= game.rating %></strong></div><a class="game-link" href="/search?q=<%= encodeURIComponent(game.title) %>">View details <span>→</span></a></article><% }) %></div></section>
<section class="library-lower"><div><p class="eyebrow">CONTINUE PLAYING</p><h2>Back in the world</h2><p class="muted-copy">Your current adventures are waiting for you.</p></div><div class="continue-card"><span class="mini-cover game-hollow">HK</span><div><strong>Hollow Knight</strong><span>68% complete</span><div class="progress"><i></i></div></div><button class="circle-button" aria-label="Continue playing">▶</button></div></section>
<%- include("partials/footer") %>

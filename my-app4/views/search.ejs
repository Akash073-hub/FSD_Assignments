<%- include("partials/header", { title }) %>
<section class="page-heading"><div><p class="eyebrow">FindHub / Registry</p><h1>Search reported items</h1><p>Every record is held by a campus custody desk until its owner is verified.</p></div><a class="button button-gold" href="/report">Report an item <span>+</span></a></section>
<form class="filter-bar" action="/search" method="get"><label class="search-wide"><span>⌕</span><input name="q" value="<%= query %>" placeholder="Search by name, detail, or location..."></label><label><span class="filter-label">Category</span><select name="category"><option>All categories</option><option <%= category === "Electronics" ? "selected" : "" %>>Electronics</option><option <%= category === "IDs & Wallets" ? "selected" : "" %>>IDs &amp; Wallets</option><option <%= category === "Bags & Apparel" ? "selected" : "" %>>Bags &amp; Apparel</option><option <%= category === "Keys & Wallets" ? "selected" : "" %>>Keys &amp; Wallets</option></select></label><button class="button button-dark" type="submit">Apply filters</button></form>
<div class="results-heading"><span><strong><%= items.length %></strong> matching records</span><span class="mono">SORTED / RECENT</span></div>
<section class="registry-grid"><% if (items.length) { items.forEach(item => { %><article class="registry-card"><div class="registry-top"><span class="item-id"><%= item.id %></span><span class="status status-<%= item.tone %>"><%= item.status %></span></div><div class="item-icon large tone-<%= item.tone %>"><%= item.icon === "wallet" ? "▰" : item.icon === "headphones" ? "◉" : item.icon === "backpack" ? "▣" : item.icon === "key" ? "⚿" : "▤" %></div><p class="eyebrow"><%= item.category %></p><h2><%= item.title %></h2><p class="card-description"><%= item.description %></p><div class="card-meta"><span>⌖ <%= item.location %></span><span>◷ <%= item.date %></span></div><form action="/claim/<%= item.id %>" method="post"><button class="claim-button" type="submit">This could be mine <span>→</span></button></form></article><% }) } else { %><div class="empty-state"><span>⌕</span><h2>No matching records</h2><p>Try a broader keyword or choose another category.</p><a class="text-link" href="/search">Reset search →</a></div><% } %></section>
<%- include("partials/footer") %>

<%- include("partials/header", { title }) %>
<section class="profile-heading"><div class="avatar avatar-large">AM</div><div><p class="eyebrow">PLAYER PROFILE / LEVEL <%= profile.level %></p><h1><%= profile.name %></h1><p class="profile-handle"><%= profile.handle %> <span>•</span> Joined March 2024</p></div><button class="button button-ghost">Edit profile <span>↗</span></button></section>
<section class="profile-grid"><article class="profile-card level-card"><div class="card-label"><span>PLAYER PROGRESS</span><strong><%= profile.xp.toLocaleString() %> / <%= profile.nextLevel.toLocaleString() %> XP</strong></div><div class="level-number"><strong><%= profile.level %></strong><span>LEVEL</span></div><div class="progress level-progress"><i style="width: 82%"></i></div><p><b>1,580 XP</b> until level 28</p></article><article class="profile-card trophy-card"><span class="trophy-icon">✦</span><div><span class="card-label">ACHIEVEMENTS</span><strong>38 / 60</strong><p>Collectors never stop.</p></div></article></section>
<section class="profile-stats"><div><span>PLAY TIME</span><strong><%= profile.hours %></strong></div><div><span>COMPLETED</span><strong><%= profile.completed %></strong></div><div><span>BACKLOG</span><strong><%= profile.backlog %></strong></div><div><span>FRIENDS</span><strong><%= profile.friends %></strong></div></section>
<section class="collection-section"><div class="section-heading"><div><p class="eyebrow">YOUR COLLECTION</p><h2>Recently played</h2></div><a class="text-link" href="/search">Manage library <span>→</span></a></div><div class="collection-list"><% games.slice(0, 4).forEach((game, index) => { %><article class="collection-row"><span class="collection-cover game-<%= game.art %>"><%= index + 1 %></span><div><strong><%= game.title %></strong><p><%= game.genre %></p></div><span class="collection-status"><%= index === 0 ? "Playing now" : index === 1 ? "Completed" : "In backlog" %></span><span class="row-arrow">→</span></article><% }) %></div></section>
<%- include("partials/footer") %>

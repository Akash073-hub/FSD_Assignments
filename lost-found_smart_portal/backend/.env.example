PORT=5000
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/findhub
# Generate a unique random value for each environment. Never commit it.
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated RVU emails used to seed trusted roles at login.
ADMIN_EMAILS=
STAFF_EMAILS=
# Development only. Production OTP delivery needs a configured email provider.
DEV_OTP=123456
